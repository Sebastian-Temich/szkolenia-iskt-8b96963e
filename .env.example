# Wzór .env.local (README.md, „Uruchomienie lokalne”, krok 3). Bez wartości w repo.
# Lokalnie: wartości z `shctl db status --projekt szkolenia-iskt --json` (pola "api" i "publishable_key").
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Wysyłka zgłoszeń przez Resend (W-12, ADR-004). Zmienne serwerowe, bez przedrostka VITE_.
# RESEND_API_KEY: sekret, wartość tylko w .env.local właściciela.
RESEND_API_KEY=
# Adres biura, które dostaje zgłoszenia.
ZGLOSZENIA_ODBIORCA=
# Nadawca e-maila, np. nazwa i adres w nawiasach ostrych.
ZGLOSZENIA_NADAWCA=
# Opcjonalnie: nagłówek platformy z adresem klienta za zaufanym proxy; lokalnie pusta.
ZGLOSZENIA_NAGLOWEK_IP=
